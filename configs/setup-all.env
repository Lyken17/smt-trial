# Host and storage configuration for every SMT-COMP 2025 Track supported here.
# Base package rationale and portability controls:
# https://github.com/SMT-COMP/smt-comp.github.io/tree/smtcomp25
# Official model-validator build requires Docker with buildx:
# https://github.com/SMT-COMP/smt-comp.github.io/tree/smtcomp25/external-tools/dolmen
all_tracks_min_free_gib="${MIN_FREE_GIB:-100}"
# shellcheck disable=SC1091
source configs/setup-single-query.env

APT_PACKAGES+=(docker.io docker-buildx)
REQUIRED_COMMANDS+=(docker)

BENCHMARK_COMPONENT=benchmarks
SOLVER_COMPONENT=solver
MIN_FREE_GIB="$all_tracks_min_free_gib"
unset all_tracks_min_free_gib
