# Host and storage configuration for every SMT-COMP 2025 Track supported here.
# Package catalogue: https://packages.ubuntu.com/
# Python venv documentation: https://docs.python.org/3/library/venv.html
# Official scrambler build: https://github.com/SMT-COMP/scrambler
# https://github.com/SMT-COMP/smt-comp.github.io/tree/smtcomp25
# Official model-validator build requires Docker with buildx:
# https://github.com/SMT-COMP/smt-comp.github.io/tree/smtcomp25/external-tools/dolmen
APT_PACKAGES=(
  ca-certificates curl git make tar build-essential flex bison m4 zstd
  python3 python3-venv python3-pip docker.io docker-buildx
)
REQUIRED_COMMANDS=(curl git make tar g++ flex bison m4 zstd python3 docker)

# These controls change only local throughput/storage placement, never official
# inputs, selection membership, seeds, scramble IDs, or scoring.
SELECTION_JOBS="${SELECTION_JOBS:-auto}"
MIN_FREE_GIB="${MIN_FREE_GIB:-100}"
NTFS_COMPRESSION="${NTFS_COMPRESSION:-auto}"
CACHE_PLACEMENT="${CACHE_PLACEMENT:-auto}"
EXTERNAL_CACHE_ROOT="${EXTERNAL_CACHE_ROOT:-}"
LARGE_LOGIC="${LARGE_LOGIC:-QF_BV}"
