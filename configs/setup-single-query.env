# Host packages required to build the SMT-COMP 2025 Single Query benchmark.
# Package catalogue: https://packages.ubuntu.com/
# Python venv documentation: https://docs.python.org/3/library/venv.html
# Official scrambler build: https://github.com/SMT-COMP/scrambler
APT_PACKAGES=(
  ca-certificates
  curl
  git
  make
  tar
  build-essential
  flex
  bison
  m4
  zstd
  python3
  python3-venv
  python3-pip
)

# Commands checked when APT cannot be used. APT itself still installs the full
# package list above, including Python's venv module and CA certificates.
REQUIRED_COMMANDS=(curl git make tar g++ flex bison m4 zstd python3)

# This phase intentionally installs/builds only Single Query prerequisites.
BENCHMARK_COMPONENT=non-incremental-benchmarks
SOLVER_COMPONENT=default-solver
# Local scramble concurrency. `auto` uses the host CPU count, capped at 16.
# It changes build throughput only; official seeds, selection membership,
# scramble IDs, and scoring remain fixed. A caller-provided value is preserved.
SELECTION_JOBS="${SELECTION_JOBS:-auto}"

# The official release README reports about 78 GB after extraction. Keep extra
# room for the 4.6 GB archives, selected copies, and temporary files.
# Source: https://zenodo.org/records/16740866/files/README.md
MIN_FREE_GIB="${MIN_FREE_GIB:-85}"
NTFS_COMPRESSION="${NTFS_COMPRESSION:-auto}"

# Storage placement is host-neutral. `auto` keeps caches below the repository
# on ordinary Linux. When the repository is on a Windows-mounted filesystem
# under WSL, prepare_storage.sh uses the current user's XDG cache directory on
# the Linux filesystem. Set EXTERNAL_CACHE_ROOT to an absolute path to override
# this choice on any host; leave it empty for automatic placement.
CACHE_PLACEMENT="${CACHE_PLACEMENT:-auto}"
EXTERNAL_CACHE_ROOT="${EXTERNAL_CACHE_ROOT:-}"
LARGE_LOGIC="${LARGE_LOGIC:-QF_BV}"
